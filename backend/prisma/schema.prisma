  tide_stations      tide_stations @relation(fields: [station_id], references: [station_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([station_id, timestamp], map: "idx_tide_station_time")
  @@index([station_id], map: "ix_tide_water_level_records_station_id")
  @@index([timestamp], map: "ix_tide_water_level_records_timestamp")
