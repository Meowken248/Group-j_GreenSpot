DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecoreport_db

# =========================================================================
# CẤU HÌNH MÔ HÌNH NGÔN NGỮ LỚN AI (KIRA AI / OPENAI-COMPATIBLE LLM)
# =========================================================================
KIRA_API_URL=https://kiraai.vn/api/v1/chat/completions
KIRA_MODEL=kira-mini-1.0
KIRA_API_KEY=your_kira_api_key_here
# Timeout gọi LLM (giây) - SRS trang 196 quy định tối đa 30-45 giây/câu trả lời
KIRA_TIMEOUT_SECONDS=45.0

# =========================================================================
# CẤU HÌNH GỬI EMAIL THẬT (GMAIL / OUTLOOK SMTP) - MÃ OTP KÍCH HOẠT
# =========================================================================
# 1. SMTP_USER: địa chỉ Gmail dùng để gửi OTP (vd: yourname@gmail.com)
# 2. SMTP_PASSWORD: Mật khẩu ứng dụng 16 ký tự (Google App Password),
#    tạo tại https://myaccount.google.com/apppasswords
#    * KHÔNG dùng mật khẩu đăng nhập Gmail thông thường.
# 3. Để trống SMTP_USER/SMTP_PASSWORD -> hệ thống chỉ in OTP ra log server.
# =========================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
