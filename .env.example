# =========================================================================
# GREENSPOT PLATFORM - CẤU HÌNH HẠ TẦNG DOCKER COMPOSE
# =========================================================================
# File này chỉ chứa cấu hình hạ tầng (PostgreSQL, cổng dịch vụ) dùng cho
# docker compose. KHÔNG đặt mật khẩu/khoá API ở đây.
#
# Toàn bộ cấu hình bí mật của ứng dụng nằm trong backend/.env:
#   1. Sao chép:  backend/.env.example  ->  backend/.env
#   2. Điền:      SMTP_USER, SMTP_PASSWORD (Google App Password),
#                 KIRA_API_KEY
#   3. Áp dụng:   docker compose up -d --force-recreate backend
# =========================================================================

POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=greenspot_db
ADMINER_PORT=8080
APP_PORT=3000

