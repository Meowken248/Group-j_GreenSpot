# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN GREENSPOT (Next.js Fullstack + PostgreSQL)
# ==============================================================================
# Hướng dẫn: Tạo bản sao file này và đổi tên thành .env
# Trong PowerShell: copy .env.example .env
# Trong Bash/Linux: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Mapbox Tokens (Bản đồ số)
# ------------------------------------------------------------------------------
# Token công khai dùng cho phía giao diện (bắt đầu bằng pk.)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Token bí mật dùng cho phía server / geocoding API (bắt đầu bằng sk.)
MAPBOX_SECRET_TOKEN=sk.your_mapbox_secret_token_here

# ------------------------------------------------------------------------------
# 2. Cấu hình Docker Compose (PostgreSQL & Adminer)
# ------------------------------------------------------------------------------
# Cổng PostgreSQL trên máy máy tính của bạn
# (MẸO: Nếu máy bạn đã cài sẵn PostgreSQL và bị chiếm cổng 5432, hãy đổi thành 5433)
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=greenspot_db

# Cổng giao diện Web xem database (Adminer: http://localhost:8080)
ADMINER_PORT=8080

# Cổng ứng dụng Next.js (nếu chạy qua Docker profile full: http://localhost:3000)
APP_PORT=3000

# ------------------------------------------------------------------------------
# 3. Chuỗi kết nối Prisma Database (DATABASE_URL)
# ------------------------------------------------------------------------------
# Nếu bạn chạy `pnpm dev` trên máy thật (kết nối vào Docker PostgreSQL):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/greenspot_db?schema=public"

# (Lưu ý: Nếu ở trên bạn đổi POSTGRES_PORT=5433 thì hãy đổi localhost:5433 ở đây tương ứng)

# ------------------------------------------------------------------------------
# 4. Khi chuyển sang Cloud / Supabase (Tùy chọn Production)
# ------------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
