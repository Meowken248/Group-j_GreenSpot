# =========================================================================
# GREENSPOT PLATFORM - CẤU HÌNH MÔI TRƯỜNG & GỬI EMAIL THẬT (SMTP)
# =========================================================================
# Để hệ thống gửi mã OTP xác thực vào hòm thư Gmail thật của bạn:
# 1. Sao chép nội dung file này vào file .env ở thư mục gốc của dự án.
# 2. Điền địa chỉ Gmail vào SMTP_USER.
# 3. Điền Mật khẩu ứng dụng (Google App Password 16 ký tự) vào SMTP_PASSWORD.
#    (Lấy tại: https://myaccount.google.com/apppasswords)
# 4. Chạy lệnh: docker compose up -d backend
# =========================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Địa chỉ email gửi OTP
SMTP_USER=

# Mật khẩu ứng dụng 16 ký tự của Google (Ví dụ: abcd efgh ijkl mnop)
SMTP_PASSWORD=
