# =========================================================================
# 🔒 ENVIRONMENT & SENSITIVE SECRETS (BẢO VỆ MẬT KHẨU & KHÓA BÍ MẬT)
# =========================================================================
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
*.local
**/*.local
# Cho phép lưu trữ các file mẫu cấu hình không chứa mật khẩu:
!.env.example
!**/.env.example
!.env.template
!**/.env.template

