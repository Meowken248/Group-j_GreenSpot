// ============================================================================
// PRISMA SCHEMA CHO HỆ THỐNG ECOREPORT (54 BẢNG NÂNG CAO)
// Quản lý & Phản ánh Sự cố Môi trường Đô thị Thông minh WebGIS
// PostgreSQL 16 + PostGIS 3.4
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuidOssp(map: "uuid-ossp"), pg_trgm, unaccent, btree_gist]
}

// ============================================================================
// 1. RBAC & NGƯỜI DÙNG (7 MODELS)
// ============================================================================

model Role {
  roleId          Int              @id @default(autoincrement()) @map("role_id")
  roleCode        String           @unique @map("role_code") @db.VarChar(50)
  roleName        String           @map("role_name") @db.VarChar(100)
  description     String?          @db.Text
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  permissionId    Int              @id @default(autoincrement()) @map("permission_id")
  module          String           @db.VarChar(50)
  action          String           @db.VarChar(50)
  permissionCode  String           @unique @map("permission_code") @db.VarChar(100)
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  role         Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  userId             String               @id @default(dbgenerated("uuid_generate_v4()")) @map("user_id") @db.Uuid
  email              String               @unique @db.VarChar(255)
  phoneNumber        String?              @unique @map("phone_number") @db.VarChar(20)
  passwordHash       String               @map("password_hash") @db.VarChar(255)
  fullName           String               @map("full_name") @db.VarChar(150)
  avatarUrl          String?              @map("avatar_url") @db.VarChar(500)
  roleId             Int                  @map("role_id")
  status             String               @default("ACTIVE") @db.VarChar(30)
  emailVerifiedAt    DateTime?            @map("email_verified_at") @db.Timestamptz
  phoneVerifiedAt    DateTime?            @map("phone_verified_at") @db.Timestamptz
  twoFactorEnabled   Boolean              @default(false) @map("two_factor_enabled")
  twoFactorSecret    String?              @map("two_factor_secret") @db.VarChar(255)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  role               Role                 @relation(fields: [roleId], references: [roleId])
  sessions           UserSession[]
  privacySettings    UserPrivacySetting?
  incidentsReported  Incident[]           @relation("ReporterIncidents")
  assignedDispatches Assignment[]         @relation("AssignedByOfficer")
  auditLogs          AuditLog[]
  notifications      Notification[]
  watchAreas         UserWatchArea[]
  mapFavorites       UserMapFavorite[]
  rewardTransactions RewardTransaction[]
  teamMemberships    TeamMember[]
  violationsIssued   ViolationRecord[]    @relation("ViolationsRecordedByUser")

  @@map("users")
}

model UserSession {
  sessionId    String   @id @default(dbgenerated("uuid_generate_v4()")) @map("session_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  jwtId        String   @unique @map("jwt_id") @db.VarChar(255)
  deviceName   String?  @map("device_name") @db.VarChar(150)
  clientType   String   @default("WEB") @map("client_type") @db.VarChar(50)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  lastActiveAt DateTime @default(now()) @map("last_active_at") @db.Timestamptz
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  isRevoked    Boolean  @default(false) @map("is_revoked")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_sessions")
}

model RefreshToken {
  tokenId   String   @id @default(dbgenerated("uuid_generate_v4()")) @map("token_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  sessionId String?  @map("session_id") @db.Uuid
  isUsed    Boolean  @default(false) @map("is_used")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("refresh_tokens")
}

model UserPrivacySetting {
  settingId                  String   @id @default(dbgenerated("uuid_generate_v4()")) @map("setting_id") @db.Uuid
  userId                     String   @unique @map("user_id") @db.Uuid
  isAnonymousByDefault       Boolean  @default(false) @map("is_anonymous_by_default")
  hideExactGps               Boolean  @default(true) @map("hide_exact_gps")
  spatialJitterRadiusMeters  Int      @default(50) @map("spatial_jitter_radius_meters")
  maskPhoneNumber            Boolean  @default(true) @map("mask_phone_number")
  allowPushNotifications     Boolean  @default(true) @map("allow_push_notifications")
  allowEmailNotifications    Boolean  @default(true) @map("allow_email_notifications")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_privacy_settings")
}

// ============================================================================
// 2. ĐỊA LÝ & HẠ TẦNG MÔI TRƯỜNG (3 MODELS)
// ============================================================================

model AdministrativeUnit {
  unitId     Int                  @id @default(autoincrement()) @map("unit_id")
  unitCode   String               @unique @map("unit_code") @db.VarChar(20)
  name       String               @db.VarChar(150)
  level      String               @db.VarChar(20)
  parentId   Int?                 @map("parent_id")
  boundary   Unsupported("geometry(MultiPolygon,4326)")?
  centroid   Unsupported("geometry(Point,4326)")?
  areaKm2    Decimal?             @map("area_km2") @db.Decimal(10, 2)
  population Int?
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  parent     AdministrativeUnit?  @relation("UnitHierarchy", fields: [parentId], references: [unitId])
  children   AdministrativeUnit[] @relation("UnitHierarchy")
  incidents  Incident[]
  workTeams  WorkTeam[]
  facilities EssentialFacility[]

  @@map("administrative_units")
}

model EssentialFacility {
  facilityId         Int                 @id @default(autoincrement()) @map("facility_id")
  facilityName       String              @map("facility_name") @db.VarChar(200)
  facilityType       String              @map("facility_type") @db.VarChar(50)
  address            String              @db.VarChar(255)
  unitId             Int?                @map("unit_id")
  location           Unsupported("geometry(Point,4326)")
  contactPhone       String?             @map("contact_phone") @db.VarChar(20)
  capacityPeople     Int?                @map("capacity_people")
  vulnerabilityLevel String              @default("HIGH") @map("vulnerability_level") @db.VarChar(20)
  metadata           Json?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  unit               AdministrativeUnit? @relation(fields: [unitId], references: [unitId])

  @@map("essential_facilities")
}

model RecyclingFacility {
  facilityId         Int                 @id @default(autoincrement()) @map("facility_id")
  name               String              @db.VarChar(200)
  facilityCode       String?             @unique @map("facility_code") @db.VarChar(50)
  address            String              @db.VarChar(255)
  unitId             Int?                @map("unit_id")
  location           Unsupported("geometry(Point,4326)")
  acceptedWasteTypes String[]            @map("accepted_waste_types")
  operatingHours     String?             @map("operating_hours") @db.VarChar(100)
  contactPhone       String?             @map("contact_phone") @db.VarChar(20)
  managingOrg        String?             @map("managing_org") @db.VarChar(150)
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("recycling_facilities")
}

// ============================================================================
// 3. TIẾP NHẬN SỰ CỐ & ĐA PHƯƠNG TIỆN (6 MODELS)
// ============================================================================

model WasteCategory {
  categoryId      Int                 @id @default(autoincrement()) @map("category_id")
  categoryCode    String              @unique @map("category_code") @db.VarChar(50)
  name            String              @db.VarChar(150)
  description     String?             @db.Text
  defaultSeverity String              @default("MEDIUM") @map("default_severity") @db.VarChar(20)
  slaHours        Int                 @default(48) @map("sla_hours")
  colorHex        String              @default("#22C55E") @map("color_hex") @db.VarChar(10)
  iconName        String              @default("trash-2") @map("icon_name") @db.VarChar(50)
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  incidents       Incident[]
  slaPolicies     SLAPolicy[]

  @@map("waste_categories")
}

model Incident {
  incidentId          String               @id @default(dbgenerated("uuid_generate_v4()")) @map("incident_id") @db.Uuid
  trackingCode        String               @unique @map("tracking_code") @db.VarChar(30)
  reporterId          String?              @map("reporter_id") @db.Uuid
  categoryId          Int                  @map("category_id")
  unitId              Int?                 @map("unit_id")
  title               String               @db.VarChar(255)
  description         String               @db.Text
  addressText         String               @map("address_text") @db.VarChar(500)
  location            Unsupported("geometry(Point,4326)")
  maskedLocation      Unsupported("geometry(Point,4326)")? @map("masked_location")
  latitude            Decimal              @db.Decimal(10, 7)
  longitude           Decimal              @db.Decimal(10, 7)
  severity            String               @default("MEDIUM") @db.VarChar(20)
  status              String               @default("PENDING") @db.VarChar(30)
  riskScore           Decimal              @default(0.00) @map("risk_score") @db.Decimal(5, 2)
  estimatedVolumeM3   Decimal?             @map("estimated_volume_m3") @db.Decimal(8, 2)
  isAnonymous         Boolean              @default(false) @map("is_anonymous")
  reporterPhoneMasked String?              @map("reporter_phone_masked") @db.VarChar(20)
  upvotesCount        Int                  @default(0) @map("upvotes_count")
  slaDeadline         DateTime?            @map("sla_deadline") @db.Timestamptz
  resolvedAt          DateTime?            @map("resolved_at") @db.Timestamptz
  closedAt            DateTime?            @map("closed_at") @db.Timestamptz
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  reporter            User?                @relation("ReporterIncidents", fields: [reporterId], references: [userId])
  category            WasteCategory        @relation(fields: [categoryId], references: [categoryId])
  administrativeUnit  AdministrativeUnit?  @relation(fields: [unitId], references: [unitId])
  media               IncidentMedia[]
  statusHistory       IncidentStatusHistory[]
  comments            IncidentComment[]
  assignments         Assignment[]
  transfers           IncidentTransfer[]
  aiSummary           AIIncidentSummary?

  @@map("incidents")
}

model IncidentMedia {
  mediaId           String               @id @default(dbgenerated("uuid_generate_v4()")) @map("media_id") @db.Uuid
  incidentId        String               @map("incident_id") @db.Uuid
  mediaType         String               @map("media_type") @db.VarChar(20)
  phase             String               @default("BEFORE") @db.VarChar(20)
  fileUrl           String               @map("file_url") @db.VarChar(500)
  thumbnailUrl      String?              @map("thumbnail_url") @db.VarChar(500)
  fileSizeBytes     BigInt?              @map("file_size_bytes")
  mimeType          String?              @map("mime_type") @db.VarChar(100)
  exifLatitude      Decimal?             @map("exif_latitude") @db.Decimal(10, 7)
  exifLongitude     Decimal?             @map("exif_longitude") @db.Decimal(10, 7)
  exifCapturedAt    DateTime?            @map("exif_captured_at") @db.Timestamptz
  isTamperedWarning Boolean              @default(false) @map("is_tampered_warning")
  uploaderId        String?              @map("uploader_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz

  incident          Incident             @relation(fields: [incidentId], references: [incidentId], onDelete: Cascade)
  aiAnalyses        AIAnalysisResult[]

  @@map("incident_media")
}

model IncidentStatusHistory {
  historyId    String   @id @default(dbgenerated("uuid_generate_v4()")) @map("history_id") @db.Uuid
  incidentId   String   @map("incident_id") @db.Uuid
  fromStatus   String?  @map("from_status") @db.VarChar(30)
  toStatus     String   @map("to_status") @db.VarChar(30)
  changedBy    String?  @map("changed_by") @db.Uuid
  changeReason String?  @map("change_reason") @db.Text
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  incident     Incident @relation(fields: [incidentId], references: [incidentId], onDelete: Cascade)

  @@map("incident_status_history")
}

model IncidentComment {
  commentId       String            @id @default(dbgenerated("uuid_generate_v4()")) @map("comment_id") @db.Uuid
  incidentId      String            @map("incident_id") @db.Uuid
  authorId        String            @map("author_id") @db.Uuid
  content         String            @db.Text
  isInternal      Boolean           @default(false) @map("is_internal")
  parentCommentId String?           @map("parent_comment_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  incident        Incident          @relation(fields: [incidentId], references: [incidentId], onDelete: Cascade)
  parentComment   IncidentComment?  @relation("CommentThread", fields: [parentCommentId], references: [commentId])
  childComments   IncidentComment[] @relation("CommentThread")

  @@map("incident_comments")
}

model IncidentTransfer {
  transferId      String   @id @default(dbgenerated("uuid_generate_v4()")) @map("transfer_id") @db.Uuid
  incidentId      String   @map("incident_id") @db.Uuid
  fromUnitId      Int      @map("from_unit_id")
  toUnitId        Int      @map("to_unit_id")
  transferredBy   String   @map("transferred_by") @db.Uuid
  reason          String   @db.Text
  escalationLevel String   @default("WARD_TO_DISTRICT") @map("escalation_level") @db.VarChar(20)
  status          String   @default("PENDING") @db.VarChar(20)
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz

  incident        Incident @relation(fields: [incidentId], references: [incidentId], onDelete: Cascade)

  @@map("incident_transfers")
}

// ============================================================================
// 4. ĐIỀU PHỐI HIỆN TRƯỜNG & NGHIỆM THU (5 MODELS)
// ============================================================================

model WorkTeam {
  teamId        Int                 @id @default(autoincrement()) @map("team_id")
  teamCode      String              @unique @map("team_code") @db.VarChar(50)
  teamName      String              @map("team_name") @db.VarChar(150)
  leaderId      String?             @map("leader_id") @db.Uuid
  unitId        Int?                @map("unit_id")
  contactPhone  String?             @map("contact_phone") @db.VarChar(20)
  vehiclePlate  String?             @map("vehicle_plate") @db.VarChar(30)
  vehicleType   String              @default("COMPACTOR_TRUCK") @map("vehicle_type") @db.VarChar(50)
  capacityTons  Decimal             @default(5.0) @map("capacity_tons") @db.Decimal(5, 2)
  status        String              @default("ACTIVE") @db.VarChar(30)
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  unit          AdministrativeUnit? @relation(fields: [unitId], references: [unitId])
  members       TeamMember[]
  assignments   Assignment[]
  kpiEvaluations KPIEvaluation[]

  @@map("work_teams")
}

model TeamMember {
  membershipId Int      @id @default(autoincrement()) @map("membership_id")
  teamId       Int      @map("team_id")
  userId       String   @map("user_id") @db.Uuid
  roleInTeam   String   @default("WORKER") @map("role_in_team") @db.VarChar(50)
  joinedAt     DateTime @default(now()) @map("joined_at") @db.Timestamptz
  isActive     Boolean  @default(true) @map("is_active")

  team         WorkTeam @relation(fields: [teamId], references: [teamId], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model WorkerLocation {
  locationId        BigInt   @id @default(autoincrement()) @map("location_id")
  teamId            Int      @map("team_id")
  userId            String?  @map("user_id") @db.Uuid
  currentLocation   Unsupported("geometry(Point,4326)") @map("current_location")
  latitude          Decimal  @db.Decimal(10, 7)
  longitude         Decimal  @db.Decimal(10, 7)
  speedKmh          Decimal  @default(0.0) @map("speed_kmh") @db.Decimal(5, 2)
  headingDegrees    Decimal? @map("heading_degrees") @db.Decimal(5, 2)
  batteryPercentage Int?     @map("battery_percentage")
  recordedAt        DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  @@map("worker_locations")
}

model Assignment {
  assignmentId   String        @id @default(dbgenerated("uuid_generate_v4()")) @map("assignment_id") @db.Uuid
  assignmentCode String        @unique @map("assignment_code") @db.VarChar(30)
  incidentId     String        @map("incident_id") @db.Uuid
  teamId         Int           @map("team_id")
  assignedBy     String        @map("assigned_by") @db.Uuid
  priority       String        @default("MEDIUM") @db.VarChar(20)
  dispatchNotes  String?       @map("dispatch_notes") @db.Text
  deadline       DateTime?     @db.Timestamptz
  status         String        @default("ASSIGNED") @db.VarChar(30)
  acceptedAt     DateTime?     @map("accepted_at") @db.Timestamptz
  startedAt      DateTime?     @map("started_at") @db.Timestamptz
  completedAt    DateTime?     @map("completed_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  incident       Incident      @relation(fields: [incidentId], references: [incidentId], onDelete: Cascade)
  team           WorkTeam      @relation(fields: [teamId], references: [teamId])
  officer        User          @relation("AssignedByOfficer", fields: [assignedBy], references: [userId])
  verification   Verification?

  @@map("assignments")
}

model Verification {
  verificationId       String     @id @default(dbgenerated("uuid_generate_v4()")) @map("verification_id") @db.Uuid
  assignmentId         String     @unique @map("assignment_id") @db.Uuid
  incidentId           String     @map("incident_id") @db.Uuid
  verifiedBy           String     @map("verified_by") @db.Uuid
  status               String     @db.VarChar(30)
  cleanlinessScore     Int?       @map("cleanliness_score")
  beforeMediaId        String?    @map("before_media_id") @db.Uuid
  afterMediaId         String?    @map("after_media_id") @db.Uuid
  actualWasteVolumeM3  Decimal?   @map("actual_waste_volume_m3") @db.Decimal(8, 2)
  actualDisposalMethod String?    @map("actual_disposal_method") @db.VarChar(100)
  feedbackNotes        String?    @map("feedback_notes") @db.Text
  verifiedAt           DateTime   @default(now()) @map("verified_at") @db.Timestamptz
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz

  assignment           Assignment @relation(fields: [assignmentId], references: [assignmentId], onDelete: Cascade)

  @@map("verifications")
}

// ============================================================================
// 5. GIÁM SÁT SLA, KIỂM TOÁN & KPI (3 MODELS)
// ============================================================================

model SLAPolicy {
  policyId                   Int            @id @default(autoincrement()) @map("policy_id")
  name                       String         @db.VarChar(150)
  categoryId                 Int?           @map("category_id")
  severity                   String         @db.VarChar(20)
  responseTimeHours          Int            @default(4) @map("response_time_hours")
  resolutionTimeHours        Int            @default(48) @map("resolution_time_hours")
  warningThresholdPercentage Int            @default(80) @map("warning_threshold_percentage")
  penaltyPointsPerHour       Decimal        @default(0.5) @map("penalty_points_per_hour") @db.Decimal(4, 2)
  isActive                   Boolean        @default(true) @map("is_active")
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category                   WasteCategory? @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)

  @@unique([categoryId, severity])
  @@map("sla_policies")
}

model AuditLog {
  logId        BigInt   @id @default(autoincrement()) @map("log_id")
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(50)
  tableName    String   @map("table_name") @db.VarChar(100)
  recordId     String?  @map("record_id") @db.VarChar(100)
  oldData      Json?    @map("old_data")
  newData      Json?    @map("new_data")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  requestUri   String?  @map("request_uri") @db.VarChar(500)
  isSuspicious Boolean  @default(false) @map("is_suspicious")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User?    @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@map("audit_logs")
}

model KPIEvaluation {
  evaluationId            Int      @id @default(autoincrement()) @map("evaluation_id")
  teamId                  Int      @map("team_id")
  unitId                  Int?     @map("unit_id")
  evaluationMonth         Int      @map("evaluation_month")
  evaluationYear          Int      @map("evaluation_year")
  totalAssigned           Int      @default(0) @map("total_assigned")
  completedOnTime         Int      @default(0) @map("completed_on_time")
  completedOverdue        Int      @default(0) @map("completed_overdue")
  slaComplianceRate       Decimal  @default(100.00) @map("sla_compliance_rate") @db.Decimal(5, 2)
  averageCleanlinessScore Decimal  @default(5.00) @map("average_cleanliness_score") @db.Decimal(3, 2)
  penaltyScore            Decimal  @default(0.00) @map("penalty_score") @db.Decimal(5, 2)
