model PenaltyRegulation {
  regulationId     Int               @id @default(autoincrement()) @map("regulation_id")
  decreeReference  String            @default("Nghị định 45/2022/NĐ-CP") @map("decree_reference") @db.VarChar(100)
  articleClause    String            @map("article_clause") @db.VarChar(50)
  violationBehavior String           @map("violation_behavior") @db.Text
  minFineVnd       Decimal           @map("min_fine_vnd") @db.Decimal(12, 2)
  maxFineVnd       Decimal           @map("max_fine_vnd") @db.Decimal(12, 2)
  remedialMeasures String?           @map("remedial_measures") @db.Text
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz

  violations       ViolationRecord[]

  @@map("penalty_regulations")
}

model ViolationRecord {
  recordId            String            @id @default(dbgenerated("uuid_generate_v4()")) @map("record_id") @db.Uuid
  recordCode          String            @unique @map("record_code") @db.VarChar(50)
  incidentId          String?           @map("incident_id") @db.Uuid
  regulationId        Int               @map("regulation_id")
  unitId              Int?              @map("unit_id")
  offenderName        String?           @map("offender_name") @db.VarChar(150)
  offenderIdCard      String?           @map("offender_id_card") @db.VarChar(20)
  offenderVehiclePlate String?          @map("offender_vehicle_plate") @db.VarChar(30)
  location            Unsupported("geometry(Point,4326)")
  address             String            @db.VarChar(255)
  recordedBy          String            @map("recorded_by") @db.Uuid
  fineAmountVnd       Decimal           @map("fine_amount_vnd") @db.Decimal(12, 2)
  status              String            @default("PENDING_PAYMENT") @db.VarChar(30)
  evidenceMediaUrls   String[]          @map("evidence_media_urls")
  paymentDeadline     DateTime?         @map("payment_deadline") @db.Date
  paidAt              DateTime?         @map("paid_at") @db.Timestamptz
  notes               String?           @db.Text
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  officer             User              @relation("ViolationsRecordedByUser", fields: [recordedBy], references: [userId])
  regulation          PenaltyRegulation @relation(fields: [regulationId], references: [regulationId])

  @@map("violation_records")
}

model SystemTranslation {
  translationId   Int      @id @default(autoincrement()) @map("translation_id")
  locale          String   @db.VarChar(10)
  translationKey  String   @map("translation_key") @db.VarChar(150)
  translationText String   @map("translation_text") @db.Text
  category        String   @default("UI") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([locale, translationKey])
  @@map("system_translations")
}

model FileStorageAsset {
  assetId          String   @id @default(dbgenerated("uuid_generate_v4()")) @map("asset_id") @db.Uuid
  storageProvider  String   @default("MINIO") @map("storage_provider") @db.VarChar(30)
  bucketName       String   @default("ecoreport-media") @map("bucket_name") @db.VarChar(100)
  filePath         String   @unique @map("file_path") @db.VarChar(500)
  originalFilename String   @map("original_filename") @db.VarChar(255)
  fileSizeBytes    BigInt   @map("file_size_bytes")
  mimeType         String   @map("mime_type") @db.VarChar(100)
  sha256Hash       String   @map("sha256_hash") @db.VarChar(64)
  cdnUrl           String?  @map("cdn_url") @db.VarChar(500)
  isPublic         Boolean  @default(true) @map("is_public")
  virusScanStatus  String   @default("CLEAN") @map("virus_scan_status") @db.VarChar(20)
  uploaderId       String?  @map("uploader_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("file_storage_assets")
}

model EnvironmentalSubscription {
  subscriptionId String    @id @default(dbgenerated("uuid_generate_v4()")) @map("subscription_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  email          String?   @db.VarChar(255)
  topic          String    @db.VarChar(50)
  unitId         Int?      @map("unit_id")
  isActive       Boolean   @default(true) @map("is_active")
  subscribedAt   DateTime  @default(now()) @map("subscribed_at") @db.Timestamptz
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz

  @@map("environmental_subscriptions")
}

model AIKnowledgeEmbedding {
  knowledgeId        String   @id @default(dbgenerated("uuid_generate_v4()")) @map("knowledge_id") @db.Uuid
  documentTitle      String   @map("document_title") @db.VarChar(255)
  documentType       String   @map("document_type") @db.VarChar(50)
  chunkIndex         Int      @default(0) @map("chunk_index")
  chunkContent       String   @map("chunk_content") @db.Text
  metadata           Json?
  embeddingDimension Int      @default(1536) @map("embedding_dimension")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("ai_knowledge_embeddings")
}
