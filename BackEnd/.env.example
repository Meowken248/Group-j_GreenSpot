# Mapbox Secret Token (dành cho Geocoding API, KHÔNG lộ ra frontend)
MAPBOX_SECRET_TOKEN=sk.xxxxx

# -----------------------------------------------------------------------------
# 1. Cấu hình Docker Compose PostgreSQL (chạy: docker compose up -d trong BackEnd)
# -----------------------------------------------------------------------------
# Đổi port nếu cổng 5432 trên máy bạn đã bị chiếm (ví dụ: 5433)
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=greenspot_db

# Chuỗi kết nối Database cho Prisma (cập nhật tương ứng port và mật khẩu ở trên)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/greenspot_db?schema=public"

# -----------------------------------------------------------------------------
# 2. Supabase PostgreSQL (khi chuyển sang Supabase)
# -----------------------------------------------------------------------------
# Transaction Mode (dành cho serverless / Next.js API Routes):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Session Mode (dành cho migrations / prisma db push):
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
