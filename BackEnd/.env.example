# Mapbox Token
MAPBOX_SECRET_TOKEN=

# -------------------------------------------------------------
# 1. Local PostgreSQL (PostgreSQL cài trực tiếp hoặc Docker)
# -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/greenspot_db?schema=public"

# -------------------------------------------------------------
# 2. Supabase PostgreSQL (khi chuyển sang Supabase)
# -------------------------------------------------------------
# Transaction Mode (dành cho serverless / Next.js API Routes):
# DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Session Mode (dành cho migrations / prisma db push):
# DIRECT_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
